# Swaylock config
# Generated by Matugen - DO NOT EDIT MANUALLY

# Background - your wallpaper blurred
screenshots
effect-blur=10x5
effect-vignette=0.5:0.5
fade-in=0.2

# Clock
clock
timestr=%I:%M %p
datestr=%A, %B %d

# Font
font=JetBrainsMono Nerd Font
font-size=55

# Background color fallback
color=131318ff

# Ring colors
ring-color=90909aff
ring-ver-color=bbc3ffff
ring-wrong-color=ffb4abff
ring-clear-color=e6bad7ff

# Key highlights
key-hl-color=bbc3ffff
bs-hl-color=ffb4abff

# Text
text-color=e4e1e9ff
text-ver-color=e4e1e9ff
text-wrong-color=ffdad6ff
text-clear-color=e4e1e9ff

# Inside of the ring
inside-color=1f1f25cc
inside-ver-color=3a4379cc
inside-wrong-color=93000acc
inside-clear-color=5d3c54cc

# Separator line between ring and inside
separator-color=00000000

# Indicator size
indicator-radius=120
indicator-thickness=12

# Show failed attempts counter
show-failed-attempts

# Disable the default "wrong password" text replacement
# Password is shown as dots automatically by swaylock

